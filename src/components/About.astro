---
import { site } from "../content/site";

const about = site.about;
---

<section id="about">
  <div class="container">
    <div class="sec-head">
      <div class="sec-num fade">{about.sectionNumber}</div>
      <h2 class="sec-title serif fade d1">
        <em class="italic">{about.titlePrefix}</em>{about.titleSuffix}
      </h2>
    </div>

    <div class="about-grid">
      <figure class="about-portrait fade d2">
        <img
          src={about.portrait.src}
          srcset={`${about.portrait.srcSmall} 480w, ${about.portrait.src} 960w`}
          sizes="(max-width: 760px) 220px, 320px"
          alt={about.portrait.alt}
          width="320"
          height="320"
          loading="eager"
          decoding="async"
          fetchpriority="low"
        />
      </figure>

      <div class="about-body fade d3">
        <p class="lead serif">{about.lead}</p>
        {about.paragraphs.map((p) => <p>{p}</p>)}

        <div class="signature">{about.signature}</div>

        <div class="credentials">
          {
            about.credentials.map((c) => (
              <div>
                <div class="label">{c.label}</div>
                <div class="val serif" set:html={c.value} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    background: var(--bg);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
    max-width: 1080px;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      justify-items: start;
    }
  }

  .about-portrait {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-2);
    position: sticky;
    top: 110px;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .about-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  @media (max-width: 860px) {
    .about-portrait {
      width: 220px;
      height: 220px;
      position: static;
      top: auto;
    }
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 4px;
    max-width: 640px;
  }

  .about-body p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  .about-body p.lead {
    font-size: 22px;
    line-height: 1.45;
  }

  .signature {
    margin-top: 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 32px;
    color: var(--accent);
  }

  .credentials {
    margin-top: 30px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .credentials .label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }

  .credentials .val {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.2;
  }
</style>
